# Keep the build context small and reproducible.
# renv local library/cache (the lockfile itself IS copied — see Dockerfile glob)
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/sandbox/
renv/python/

# RStudio / R session cruft
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# workflowr knit byproducts + rendered site (regenerable in-container)
analysis/*_cache/
analysis/figure/
docs/

# large raw data & regenerable outputs (mount these at runtime instead)
data/*.csv
data/*.tsv
data/*.maf
output/clean_data/

# local-only harness / notes (already git-ignored)
.claude/
.citadel/
.planning/
research/
AGENTS.md
CLAUDE.md

# vcs / os
.git/
.DS_Store
