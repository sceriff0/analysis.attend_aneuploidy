# Randomstuff
plottoday.png
old.png
# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
# base-graphics byproduct: any Rscript that draws to the null device drops this here
Rplots.pdf

# --- renv ---
# Track renv.lock, settings, and activate.R; ignore the local library + cache.
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# --- workflowr ---
# The rendered site (docs/) IS tracked by workflowr — do not ignore it.
# Knit byproducts that should not be committed:
analysis/*_cache/
analysis/figure/

# --- data / outputs ---
# Large raw data and regenerable outputs are not version-controlled here.
# Remove these lines if you intend to commit small reference inputs/outputs.
data/*.csv
data/*.tsv
data/*.maf
data/*.seg
output/clean_data/*.csv
output/gistic_input/
# The data inventory is 62 MB (ids.tsv alone is 61 MB) and is fully regenerable by
# code/inventory_data.R. Kept on disk, kept out of git — a blob that size can never be
# removed from history, and GitHub rejects single files over 100 MB.
output/inventory/
# Raw WES/CNV inputs synced from HPC live in these subfolders — never commit them:
data/seg/
data/ascets/
data/cnv_annotations/
data/variant_annotations/
data/gistic/
data/nassar/
data/tcga/
data/tcga_2013/
data/*
output/*
# ...but the small bundled reference tables (config, not raw data) ARE tracked:
!data/arm_boundaries_*.tsv
# TCGA 2013 published GISTIC peaks (Suppl. Data File S2.1), converted to TSV — a small
# reference table, not raw data, and the pipeline reads it instead of the .xls.
!data/tcga_gistic_peaks_2013.tsv
# Wu et al. (Immunity 2025) Table S3 — the pooled CRISPR-Cas9 resister/sensitizer gene
# catalogue, converted from *mmc4.xlsx by code/fetch_crispr_screens.R. 124 kB of gene
# symbols: a reference table on the same footing as the peaks above. The .xlsx it came
# from is raw supplementary material and stays ignored.
!data/crispr_t_cell_screens_wu2025.tsv

# Publisher supplementary downloads landing at the repo root (Elsevier names them
# 1-s2.0-<PII>-main.pdf / -mmcN.xlsx). Raw source material, same footing as papers/ below:
# multi-MB, redistributable only under the article's licence, and the pipeline never reads
# them directly — it reads the small derived tables converted out of them. Ignored at the
# root rather than moved, because code/fetch_crispr_screens.R globs *mmc4.xlsx here.
1-s2.0-*

# --- third-party tools cloned by helper scripts (not vendored) ---
# code/run_ascets_tcga.sh clones github.com/beroukhim-lab/ascets here.
tools/

# --- research / planning notes (local only) ---
research/
papers/

# --- Claude Code / Citadel harness (local only, not version-controlled) ---
.claude/
.citadel/
.planning/
docs/superpowers/
AGENTS.md
CLAUDE.md

# --- OS ---
.DS_Store

# MATLAB MCR component cache, created by code/run_gistic.sh (container has no /tmp)
.mcr_cache/

# Singularity/Apptainer images (gistic2.sif is multi-GB — never commit it)
*.sif
